#!/bin/sh
set -eu

version=${1:-}
checksums=${2:-}
if ! printf '%s\n' "$version" | grep -Eq '^v(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$'; then
	printf 'usage: %s vMAJOR.MINOR.PATCH CHECKSUMS_FILE\n' "$0" >&2
	exit 2
fi
if [ ! -f "$checksums" ]; then
	printf 'checksums file not found: %s\n' "$checksums" >&2
	exit 1
fi

version_number=${version#v}
checksum() {
	name=$1
	value=$(awk -v name="$name" '$2 == name { print $1 }' "$checksums")
	if [ -z "$value" ]; then
		printf 'missing checksum for %s\n' "$name" >&2
		exit 1
	fi
	if ! printf '%s\n' "$value" | grep -Eq '^[0-9a-fA-F]{64}$'; then
		printf 'invalid checksum for %s\n' "$name" >&2
		exit 1
	fi
	printf '%s' "$value"
}

darwin_amd64="earwig_${version_number}_darwin_amd64.tar.gz"
darwin_arm64="earwig_${version_number}_darwin_arm64.tar.gz"
linux_amd64="earwig_${version_number}_linux_amd64.tar.gz"
linux_arm64="earwig_${version_number}_linux_arm64.tar.gz"

cat <<EOF
# typed: strict
# frozen_string_literal: true

# This file is generated by Earwig's release workflow. DO NOT EDIT.
class Earwig < Formula
  desc "Capture Codex and Claude Code turns for local evaluation"
  homepage "https://github.com/CaliLuke/earwig"
  version "$version_number"

  on_macos do
    if Hardware::CPU.intel?
      url "https://github.com/CaliLuke/earwig/releases/download/$version/$darwin_amd64"
      sha256 "$(checksum "$darwin_amd64")"
    end
    if Hardware::CPU.arm?
      url "https://github.com/CaliLuke/earwig/releases/download/$version/$darwin_arm64"
      sha256 "$(checksum "$darwin_arm64")"
    end
  end

  on_linux do
    if Hardware::CPU.intel? && Hardware::CPU.is_64_bit?
      url "https://github.com/CaliLuke/earwig/releases/download/$version/$linux_amd64"
      sha256 "$(checksum "$linux_amd64")"
    end
    if Hardware::CPU.arm? && Hardware::CPU.is_64_bit?
      url "https://github.com/CaliLuke/earwig/releases/download/$version/$linux_arm64"
      sha256 "$(checksum "$linux_arm64")"
    end
  end

  def install
    bin.install "earwig"
    libexec.install "claude-reader"
  end

  service do
    run [opt_bin/"earwig", "watch"]
    environment_variables PATH: std_service_path_env
    keep_alive true
    working_dir var
    log_path var/"log/earwig.log"
    error_log_path var/"log/earwig.log"
  end

  test do
    assert_match version.to_s, shell_output("#{bin}/earwig version")
  end
end
EOF
